<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
      font-size: 12pt;
    }

    h1 {
      font-size: 24pt;
      margin-bottom: 30px;
      text-align: left;
    }

    h2 {
      font-size: 18pt;
      margin-top: 40px;
      margin-bottom: 20px;
      text-align: left;
    }

    h3 {
      font-size: 14pt;
      margin-top: 30px;
      margin-bottom: 15px;
      text-align: left;
      font-weight: bold;
    }

    p {
      text-align: left;
      line-height: 1.5;
      margin: 10px 0;
    }

    .section {
      margin-bottom: 30px;
    }

    .song {
      margin-bottom: 25px;
    }
  </style>
</head>
<body>
  <h1><%= @playlist.name.titleize %></h1>

  <% @playlist.playlist_sections.each do |section| %>
    <div class="section">
      <h2><%= section.name.titleize %></h2>

      <% section.playlist_items.each do |item| %>
        <% next unless item.song %>

        <div class="song">
          <h3><%= "#{item.position}. #{item.song.title.titleize}" %></h3>

          <% if item.song.content.present? %>
            <% item.song.content.split(/\n+/).each do |para| %>
              <% next if para.strip.empty? %>
              <p><%= para %></p>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</body>
</html>
